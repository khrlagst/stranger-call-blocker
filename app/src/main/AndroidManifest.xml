<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required: read contacts to check if caller is known -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Required: phone state for call screening -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Required: check for updates via GitHub API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required: install downloaded APK updates (Android 8+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".StrangerBlockerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StrangerCallBlocker">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            CallScreeningService — bound service that the Telecom framework
            invokes on every incoming call. Must be declared with the
            BIND_SCREENING_SERVICE permission.
        -->
        <service
            android:name=".service.CallBlockerService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
